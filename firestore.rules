rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownersDoc() { return /databases/$(database)/documents/settings/owners; }
    // Owners are listed in settings/owners. Until that list exists, every signed-in tablet counts as an owner.
    function isOwner() {
      return signedIn() && (!exists(ownersDoc()) || get(ownersDoc()).data.emails.size() == 0
        || (request.auth.token.email != null && request.auth.token.email.lower() in get(ownersDoc()).data.emails));
    }

    // Menu: anyone can read (kiosk and online ordering).
    match /menu/{doc=**} {
      allow read: if true;
    }
    // Menu settings, modifier groups: owners only.
    match /menu/main { allow write: if isOwner(); }
    match /menu/main/modifierGroups/{id} { allow write: if isOwner(); }
    // Items: owners change anything; any signed-in tablet can 86 or change counts.
    match /menu/main/items/{id} {
      allow create, delete: if isOwner();
      allow update: if isOwner() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eightySixed', 'stockCount']));
    }
    // Live counts and on/off switches (online ordering, kiosk drinks): any signed-in tablet.
    match /menu/modStock { allow write: if signedIn(); }
    match /menu/status { allow write: if signedIn(); }
    // Online pre-order limits per item per day: owners only.
    match /menu/preorderLimits { allow write: if isOwner(); }

    // Owner list and staff codes: owners change them; signed-in tablets read staff codes to unlock.
    match /settings/owners { allow read: if signedIn(); allow write: if isOwner(); }
    match /settings/staff { allow read: if signedIn(); allow write: if isOwner(); }
    match /settings/printers { allow read: if signedIn(); allow write: if isOwner(); }
    // Print requests (receipts, reprints, test prints): any signed-in tablet; the print bridge updates them.
    match /printJobs/{id} { allow read, write: if signedIn(); }

    // Everything else (orders, counters, KDS settings, events): signed-in tablets.
    match /orders/{doc=**} { allow read, write: if signedIn(); }
    match /counters/{doc=**} { allow read, write: if signedIn(); }
    match /settings/kds { allow read, write: if signedIn(); }
    match /events/{doc=**} { allow read, write: if signedIn(); }
    // Rewards members by phone number.
    match /customers/{phone} { allow read, write: if signedIn(); }
    // Online checkouts waiting for payment (written by the online ordering function's sign-in).
    match /onlineCheckouts/{id} { allow read, write: if signedIn(); }
    // Gift cards: balances change only in transactions from the register and Orders and reports; every change is logged.
    match /giftCards/{num} { allow read, write: if signedIn(); }
    match /giftCardTx/{id} { allow read, create: if signedIn(); }
    // Online gift card lookups per connection (slows down guessing)
    match /giftLookups/{id} { allow read, write: if signedIn(); }
    // Texts and emails to send, and their settings. (Sign-ups live on the customer record.)
    match /textBlasts/{id} { allow read, write: if signedIn(); }
    match /settings/texts { allow read, write: if signedIn(); }
    // Points expiration policy: owners change it; the daily job records its runs separately.
    match /settings/rewards { allow read: if signedIn(); allow write: if isOwner(); }
    match /settings/rewardsRun { allow read, write: if signedIn(); }
  }
}
